# Database credentials
DB_USER=app
DB_PASSWORD=secret
DB_HOST=localhost
DB_PORT=3306
DB_NAME=peercast_yp

# PCP (PeerCast Protocol) listen port
PCP_PORT=7144
# Development Caddy host HTTP port (app HTTP port is configured in TOML)
HTTP_PORT=80

# Domain name used by Caddy for TLS and virtual hosting
SITE_DOMAIN=yayaue.me
# Caddy path matcher; keep /yp to match the current application and frontend.
YP_PATH=/yp
